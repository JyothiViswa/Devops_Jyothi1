pipeline {
    agent { label '34.199.175.141_Agent2' }

    environment {
        IMAGE_NAME = "webapp-app"
        DOCKER_REGISTRY_CREDENTIALS = "jyothihelios"
        DOCKER_HUB_REPO = "jyothihelios/webapp-app" 
    }

    stages {
        stage('Job1 : build') {
            steps {
                echo "Pulling code from GitHub repository..."
                git branch: 'master', url: 'https://github.com/JyothiViswa/Devops_Jyothi1.git'
                
                echo "Building Docker image from Dockerfile..."
                sh "docker build -t ${IMAGE_NAME}:${env.BUILD_NUMBER} ."
            }
        }

        stage('Job2 : test') {
            steps {
                sh """
                    echo "Starting container for testing..."
                    docker run -d --name temp-webapp-test -p 8081:80 ${IMAGE_NAME}:${env.BUILD_NUMBER}

                    # Give Apache a couple of seconds to initialize
                    sleep 3
                    
                    # Run curl test to verify the server is responding
                    curl -f http://localhost:8081 || (docker stop temp-webapp-test && docker rm temp-webapp-test && exit 1)
                    
                    # Clean up the test container
                    docker stop temp-webapp-test
                    docker rm temp-webapp-test
                """
            }
        }

        stage('Job3 : prod') {
            steps {
                echo "Pushing and pulling image to production server..."
                sh """
                    # Optional: Login to Docker Hub if your repository is private
                    # echo "${Learning1664$$}" | docker login -u "${jyothihelios}" --password-stdin

                    echo "Tagging image for Docker Hub..."
                    docker tag ${IMAGE_NAME}:${env.BUILD_NUMBER} ${DOCKER_HUB_REPO}:latest

                    echo "Pushing image to Docker Hub registry..."
                    docker push ${DOCKER_HUB_REPO}:latest

                    echo "Deploying to production container server..."
                    # Stop and remove any existing production container safely
                    docker stop production-webapp || true
                    docker rm production-webapp || true

                    echo "Pulling latest image from registry and running production container..."
                    docker pull ${DOCKER_HUB_REPO}:latest
                    docker run -d --name production-webapp -p 80:80 ${DOCKER_HUB_REPO}:latest
                    
                    echo "Production deployment completed successfully!"
                """
            }
        }
    }
    post {
        always {
            echo "Cleaning up local build images..."
            sh "docker rmi ${IMAGE_NAME}:${env.BUILD_NUMBER} || true"
        }
    }   
}
